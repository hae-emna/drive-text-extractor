# Copy this file to .env and fill in the values. Never commit .env.

# Where folders are read from: google_drive (default) or local (demo mode, no API key needed).
FILE_SOURCE=google_drive

# Root folder of the local source. Folder links then look like "local:" or "local:subfolder".
LOCAL_FOLDER=../samples/input

# Google Cloud API key with the Google Drive API enabled.
# Create one at https://console.cloud.google.com/apis/credentials and restrict it to the Drive API.
GOOGLE_API_KEY=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Files processed at the same time. OCR is CPU-bound: keep it near the number of CPU cores.
BATCH_CONCURRENCY=2

# OCR results with a mean word confidence (0-100) below this are flagged as low confidence.
LOW_CONFIDENCE_THRESHOLD=60

# Files above this size (in MB) are refused before or while downloading.
MAX_FILE_SIZE_MB=25

# Folder listing stops after this many files.
MAX_LISTED_FILES=1000

# PDFs with more pages than this are refused.
MAX_PDF_PAGES=200

# PDF pages whose text layer has fewer visible characters are treated as scans and OCR'd.
PDF_OCR_MIN_CHARS=20

# Resolution (DPI) used to render scanned PDF pages for OCR.
PDF_RENDER_DPI=300

# Images with more megapixels than this are refused before decoding.
MAX_IMAGE_MEGAPIXELS=50

# Seconds before Tesseract is stopped on one image or page.
OCR_TIMEOUT_SECONDS=120

# Detect and fix sideways or upside-down scans before OCR (one extra Tesseract pass per image).
OCR_AUTO_ROTATE=true
